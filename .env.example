# URL do gateway Nginx dos microsserviços (repo mce-celulares)
VITE_API_URL=http://localhost:8080

# Pagamento com Mercado Pago: o front não tem chave nem token do Mercado Pago.
# Para onde o Mercado Pago devolve o cliente depois de pagar é configurado no BACK-END
# (pagamento-service/.env: FRONTEND_URL = origem deste front, ex.: http://localhost:4000).
# A tela de retorno é /checkout/retorno/:id e fica nesta aplicação.
